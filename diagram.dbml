Project kuchenny_sklep {
  database_type: 'MariaDB'
  Note: 'Opisanie bazy danych sklepu internetowego zajmującego się sprzedażą sprzętu do kuchni'
}

Table users {
  user_id "BIGINT UNSIGNED" [pk, increment, not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30) [null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Przechowuje dane kont zarejestrowanych klientów sklepu (zarówno klientów indywidualnych, jak i przedstawicieli restauracji). Stanowi główną encję uwierzytelniania oraz właściciela zamówień i książki adresowej.'
}

Table addresses {
  address_id "BIGINT UNSIGNED" [pk, increment, not null]
  user_id "BIGINT UNSIGNED" [not null]
  recipient_name varchar(150) [not null]
  street_line1 varchar(255) [not null]
  street_line2 varchar(255) [null]
  city varchar(100) [not null]
  state_province varchar(100) [not null]
  postal_code varchar(20) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, address_id) [unique, name: 'uq_addresses_user_address']
  }

  Note: 'Książka adresowa użytkowników. Przechowuje adresy dostaw (np. dom, lokal gastronomiczny) oraz dane adresowe wykorzystywane do wystawiania faktur (adresy rozliczeniowe).'
}

Table categories {
  category_id "INT UNSIGNED" [pk, increment, not null]
  parent_id "INT UNSIGNED" [null]
  name varchar(100) [not null]

  Note: 'Słownik kategorii asortymentu kuchennego obsługujący strukturę drzewiastą (hierarchiczną) dzięki relacji zwrotnej `parent_id`. Pozwala dzielić główne działy (np. _Noże kuchenne_) na węższe podkategorie (np. _Noże Santoku_).'
}

Table products {
  product_id "BIGINT UNSIGNED" [pk, increment, not null]
  sku varchar(64) [not null, unique]
  name varchar(200) [not null]
  brand varchar(100) [not null]
  description text [null]
  base_price decimal(10,2) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Główny katalog produktów oferowanych przez sklep (noże szefa kuchni, zastawa porcelanowa, patelnie żeliwne, garnki i akcesoria). Przechowuje parametry fizyczne towaru oraz jego bieżącą cenę katalogową.'
}

Table product_categories {
  product_id "BIGINT UNSIGNED" [not null]
  category_id "INT UNSIGNED" [not null]

  indexes {
    (product_id, category_id) [pk]
  }

  Note: 'Tabela asocjacyjna (łącząca) realizująca relację wiele-do-wielu (N:M) pomiędzy produktami a kategoriami. Umożliwia przypisanie jednego artykułu kuchennego do kilku kategorii jednocześnie.'
}
