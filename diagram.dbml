Project kuchenny_sklep {
  database_type: 'MariaDB'
  Note: 'Opisanie bazy danych sklepu internetowego zajmującego się sprzedażą sprzętu do kuchni'
}

enum order_status_enum {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
}

enum payment_method_enum {
  credit_card
  paypal
  bank_transfer
  stripe
  blik
}

enum payment_status_enum {
  initiated
  completed
  failed
  refunded
}

enum shipment_status_enum {
  label_created
  in_transit
  out_for_delivery
  delivered
}

Table users {
  user_id "BIGINT UNSIGNED" [pk, increment, not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30) [null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Przechowuje dane kont zarejestrowanych klientów sklepu (zarówno klientów indywidualnych, jak i przedstawicieli restauracji). Stanowi główną encję uwierzytelniania oraz właściciela zamówień i książki adresowej.'
}

Table addresses {
  address_id "BIGINT UNSIGNED" [pk, increment, not null]
  user_id "BIGINT UNSIGNED" [not null]
  recipient_name varchar(150) [not null]
  street_line1 varchar(255) [not null]
  street_line2 varchar(255) [null]
  city varchar(100) [not null]
  state_province varchar(100) [not null]
  postal_code varchar(20) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, address_id) [unique, name: 'uq_addresses_user_address']
  }

  Note: 'Książka adresowa użytkowników. Przechowuje adresy dostaw (np. dom, lokal gastronomiczny) oraz dane adresowe wykorzystywane do wystawiania faktur (adresy rozliczeniowe).'
}

Table categories {
  category_id "INT UNSIGNED" [pk, increment, not null]
  parent_id "INT UNSIGNED" [null]
  name varchar(100) [not null]

  Note: 'Słownik kategorii asortymentu kuchennego obsługujący strukturę drzewiastą (hierarchiczną) dzięki relacji zwrotnej `parent_id`. Pozwala dzielić główne działy (np. _Noże kuchenne_) na węższe podkategorie (np. _Noże Santoku_).'
}

Table products {
  product_id "BIGINT UNSIGNED" [pk, increment, not null]
  sku varchar(64) [not null, unique]
  name varchar(200) [not null]
  brand varchar(100) [not null]
  description text [null]
  base_price decimal(10,2) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Główny katalog produktów oferowanych przez sklep (noże szefa kuchni, zastawa porcelanowa, patelnie żeliwne, garnki i akcesoria). Przechowuje parametry fizyczne towaru oraz jego bieżącą cenę katalogową.'
}

Table product_categories {
  product_id "BIGINT UNSIGNED" [not null]
  category_id "INT UNSIGNED" [not null]

  indexes {
    (product_id, category_id) [pk]
  }

  Note: 'Tabela asocjacyjna (łącząca) realizująca relację wiele-do-wielu (N:M) pomiędzy produktami a kategoriami. Umożliwia przypisanie jednego artykułu kuchennego do kilku kategorii jednocześnie.'
}

Table inventory {
  product_id "BIGINT UNSIGNED" [pk, not null]
  quantity int [not null, default: 0]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Przechowuje aktualny stan magazynowy każdego produktu. Każdy produkt ma dokładnie jeden rekord stanu (`PRIMARY KEY` to `product_id`). Zapobiega sprzedaży towaru poniżej zera dzięki ograniczeniu `CHECK (quantity >= 0)`.'
}

Table orders {
  order_id "BIGINT UNSIGNED" [pk, increment, not null]
  user_id "BIGINT UNSIGNED" [not null]
  shipping_address_id "BIGINT UNSIGNED" [not null]
  billing_address_id "BIGINT UNSIGNED" [not null]
  order_status order_status_enum [not null, default: 'pending']
  total_amount decimal(10,2) [not null, default: 0.00]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Tabela nagłówków zamówień składanych przez klientów. Łączy kupującego z wybranym adresem dostawy i adresem rozliczeniowym oraz przechowuje aktualny status realizacji i łączną wartość koszyka.'
}

Table order_items {
  order_item_id "BIGINT UNSIGNED" [pk, increment, not null]
  order_id "BIGINT UNSIGNED" [not null]
  product_id "BIGINT UNSIGNED" [not null]
  quantity "INT UNSIGNED" [not null]
  unit_price decimal(10,2) [not null]

  indexes {
    (order_id, product_id) [unique, name: 'uq_order_product']
  }

  Note: 'Szczegółowy wykaz pozycji wchodzących w skład zamówienia. Rejestruje zamawianą ilość oraz historyczną cenę jednostkową obowiązującą w momencie zakupu.'
}

Table payments {
  payment_id "BIGINT UNSIGNED" [pk, increment, not null]
  order_id "BIGINT UNSIGNED" [not null]
  payment_method payment_method_enum [not null]
  transaction_reference varchar(255) [not null, unique]
  amount decimal(10,2) [not null]
  payment_status payment_status_enum [not null, default: 'initiated']
  paid_at timestamp [null]

  Note: 'Rejestr transakcji płatniczych powiązanych z zamówieniami. Pozwala śledzić wybraną metodę płatności, zewnętrzne numery referencyjne bramek płatniczych, nieudane próby oraz zwroty.'
}

Table shipments {
  shipment_id "BIGINT UNSIGNED" [pk, increment, not null]
  order_id "BIGINT UNSIGNED" [not null]
  carrier varchar(100) [not null]
  tracking_number varchar(150) [null, unique]
  shipment_status shipment_status_enum [not null, default: 'label_created']
  shipped_at timestamp [null]
  delivered_at timestamp [null]

  Note: 'Ewidencja przesyłek kurierskich i paczkomatowych realizujących dostawę zamówienia. Jedno zamówienie może być podzielone na wiele przesyłek (np. przy wysyłce w osobnych paczkach).'
}

Table v_product_stock_summary {
  product_id "BIGINT UNSIGNED"
  sku varchar(64)
  product_name varchar(200)
  brand varchar(100)
  base_price decimal(10,2)
  total_stock int
  total_price decimal(10,2)

  Note: 'Widok raportowy łączący produkty z ich aktualnym stanem magazynowym. Dzięki zastosowaniu `LEFT JOIN` produkty bez rekordu w tabeli `inventory` również pojawiają się w wyniku (z `total_stock` równym 0).'
}

// Connections between tables
Ref fk_addresses_user: addresses.user_id > users.user_id [delete: cascade]
Ref fk_categories_parent: categories.parent_id > categories.category_id [delete: set null]
Ref fk_pc_product: product_categories.product_id > products.product_id [delete: cascade]
Ref fk_pc_category: product_categories.category_id > categories.category_id [delete: cascade]
Ref fk_inv_product: products.product_id - inventory.product_id [delete: restrict]
Ref fk_orders_user: orders.user_id > users.user_id [delete: restrict]
Ref fk_orders_shipping_addr: orders.(user_id, shipping_address_id) > addresses.(user_id, address_id) [delete: restrict]
Ref fk_orders_billing_addr: orders.(user_id, billing_address_id) > addresses.(user_id, address_id) [delete: restrict]
Ref fk_items_order: order_items.order_id > orders.order_id [delete: cascade]
Ref fk_items_product: order_items.product_id > products.product_id [delete: restrict]
Ref fk_payments_order: payments.order_id > orders.order_id [delete: restrict]
Ref fk_shipments_order: shipments.order_id > orders.order_id [delete: cascade]
